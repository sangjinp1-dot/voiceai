{
  "expo": {
    "name": "Sangjin Voice AI",
    "slug": "sangjin-voice-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sangjinvoiceai",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.sangjin.voiceai",
      "versionCode": 10,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "음성 녹음과 STT 변환을 위해 마이크 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "replace-with-your-eas-project-id"
      }
    }
  }
}
